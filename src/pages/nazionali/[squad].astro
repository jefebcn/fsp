---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NewsGrid from '../../components/NewsGrid.astro';
import { NAZIONALI } from '../../data/site';
import { getAllNews, byCategory, matching } from '../../lib/news';
export function getStaticPaths() { return NAZIONALI.map((s) => ({ params: { squad: s.slug }, props: { s } })); }
const { s } = Astro.props;
const news = matching(byCategory(await getAllNews(), 'nazionali'), s.newsMatch);
---
<Base title={s.name} description={`${s.name} di San Marino: giocatori e staff ${s.season}.`} image={s.photo}>
  <PageHero title={s.name} intro={`Rosa ${s.season}`} crumbs={[{ label: 'Nazionali', href: '/nazionali/' }]} />
  <section class="section">
    <div class="wrap sq">
      <figure class="sq__photo"><img src={s.photo} alt={`La ${s.name} ${s.season}`} width="1000" height="600" /></figure>
      <div>
        <h2>I giocatori</h2>
        <ol class="roster">
          {s.players.map((p) => <li><span class="roster__n">{p.name}</span>{p.born && <span class="roster__b">nato il {p.born}</span>}</li>)}
        </ol>
        <h2>Lo staff</h2>
        <ul class="roster roster--staff">
          {s.staff.map((p) => <li><span class="roster__n">{p.name}</span><span class="roster__b">{p.role}</span></li>)}
        </ul>
      </div>
    </div>
  </section>
  <section class="section section--soft">
    <div class="wrap">
      <h2>Notizie {s.name}</h2>
      <NewsGrid items={news.slice(0, 12)} />
    </div>
  </section>
</Base>
<style>
  .sq { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: start; }
  .sq__photo { margin: 0; position: sticky; top: 150px; }
  .sq__photo img { border-radius: var(--radius); width: 100%; }
  .roster { list-style: none; padding: 0; margin: 0 0 32px; display: grid; gap: 8px; counter-reset: r; }
  .roster li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 12px 16px; background: var(--c-bg-soft); border-radius: var(--radius-sm); border-left: 4px solid var(--c-cyan); }
  .roster--staff li { border-left-color: var(--c-orange); }
  .roster__n { font-weight: 700; }
  .roster__b { color: var(--c-muted); }
  @media (max-width: 860px) { .sq { grid-template-columns: 1fr; } .sq__photo { position: static; } }
</style>
