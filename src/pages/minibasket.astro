---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NewsGrid from '../components/NewsGrid.astro';
import PersonCard from '../components/PersonCard.astro';
import Icon from '../components/Icon.astro';
import { STAFF_TECNICO, SITE, tel } from '../data/site';
import { getAllNews, byCategory } from '../lib/news';
const news = byCategory(await getAllNews(), 'minibasket');
const staff = STAFF_TECNICO.filter((p) => /minibasket/i.test(p.role));
---
<Base title="Minibasket" description="Minibasket a San Marino per bambine e bambini dai 5 agli 11 anni: centri a Serravalle e San Marino Città.">
  <PageHero title="Minibasket" intro="Per bambine e bambini dai 5 agli 11 anni: il primo passo nel mondo del basket, giocando e divertendosi." crumbs={[{ label: 'Giovani' }]}>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px">
      <a class="btn btn--primary" href="/contatti/?oggetto=Iscrizione%20Minibasket">Chiedi come iscriverti</a>
      <a class="btn btn--light" href="/attivita/centro-estivo/">Centro estivo</a>
    </div>
  </PageHero>
  <section class="section">
    <div class="wrap mb">
      <div class="prose">
        <h2 style="margin-top:0">Più di un gioco</h2>
        <p>La pallacanestro va oltre il gioco: è un'occasione per trasmettere valori come il <strong>rispetto</strong>, il <strong>lavoro di squadra</strong> e la <strong>determinazione</strong>. Nel minibasket, insegniamo ai giovani non solo a giocare, ma anche a crescere come individui.</p>
        <p>Vediamo lo sport come un'opportunità educativa preziosa, capace di fornire importanti messaggi e servizi ai nostri giovani atleti.</p>
        <p><strong>Gestiamo due centri Minibasket</strong>, a Serravalle e San Marino Città, operativi da settembre a giugno, con uno staff di prim'ordine coordinato da Oscar Valentini, responsabile del settore dedicato ai bambini dai 5 agli 11 anni e con un'esperienza trentennale sul nostro territorio. La voglia di giocare, la competenza e una grande dose di empatia rendono il settore Minibasket il nostro fiore all'occhiello.</p>
      </div>
      <aside>
        <ul class="facts-mb">
          <li><Icon name="child" size={28} /><div><strong>5-11 anni</strong><span>bambine e bambini</span></div></li>
          <li><Icon name="pin" size={28} /><div><strong>2 centri</strong><span>Serravalle e San Marino Città</span></div></li>
          <li><Icon name="calendar" size={28} /><div><strong>Settembre-giugno</strong><span>tutto l'anno scolastico</span></div></li>
          <li><Icon name="heart" size={28} /><div><strong>Gold Plus</strong><span>certificato di qualità FIP 2025</span></div></li>
        </ul>
        <div class="info-box" style="margin-top:16px">
          <h3>Informazioni e iscrizioni</h3>
          <p style="margin:0">Segreteria FSP: <a href={tel(SITE.phone)}>{SITE.phone}</a><br />Cell. <a href={tel(SITE.mobile)}>{SITE.mobile}</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
      </aside>
    </div>
  </section>
  <section class="section section--soft">
    <div class="wrap">
      <h2>Istruttori e istruttrici</h2>
      <ul class="grid grid--3" style="list-style:none;padding:0;margin:0">{staff.map((p) => <PersonCard person={p} />)}</ul>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Notizie dal Minibasket</h2><a class="btn btn--ghost" href="/news/categoria/minibasket/">Tutte <Icon name="arrow" /></a></div>
      <NewsGrid items={news.slice(0, 6)} />
    </div>
  </section>
</Base>
<style>
  .mb { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: start; }
  .facts-mb { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .facts-mb li { display: flex; gap: 14px; align-items: center; background: var(--c-orange-soft); border-radius: var(--radius-sm); padding: 14px 18px; }
  .facts-mb :global(svg) { color: var(--c-orange-dark); flex: none; }
  .facts-mb strong { display: block; color: var(--c-navy); font-size: 1.1rem; }
  .facts-mb span { color: var(--c-muted); }
  @media (max-width: 860px) { .mb { grid-template-columns: 1fr; } }
</style>
