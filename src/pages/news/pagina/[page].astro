---
import NewsIndex from '../../../components/NewsIndex.astro';
import { getAllNews } from '../../../lib/news';
import { pageCount } from '../../../lib/paging';
export async function getStaticPaths() {
  const n = pageCount((await getAllNews()).length);
  return Array.from({ length: n - 1 }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const page = Number(Astro.params.page);
---
<NewsIndex page={page} />
