---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import NewsGrid from '../../components/NewsGrid.astro';
import { SITE, tel, CENTRO_ESTIVO } from '../../data/site';
import { getAllNews, matching } from '../../lib/news';
const news = matching(await getAllNews(), /centro estivo|centri estivi|summer camp|camp estivo/i).slice(0, 3);
const ce = CENTRO_ESTIVO;
const icons = ['users', 'ball', 'heart', 'sun', 'clock', 'food', 'child', 'star', 'clock'];
---
<Base title="Centro estivo" description="Centro estivo di basket a San Marino per bambini e bambine dai 5 agli 11 anni." image={CENTRO_ESTIVO.poster}>
  <PageHero title="Centro estivo" intro={ce.intro} crumbs={[{ label: 'Attività', href: '/attivita/' }]}>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px">
      <a class="btn btn--primary" href="/contatti/?oggetto=Centro%20estivo">Richiedi informazioni</a>
    </div>
  </PageHero>
  <section class="section">
    <div class="wrap ce">
      <div>
        <ul class="ce-facts">
          {ce.info.map((f) => <li><Icon name={f.icon} size={28} /><div><strong>{f.title}</strong>{f.text}</div></li>)}
        </ul>
        <h2>Programma della giornata</h2>
        <ol class="day">
          {ce.programma.map((p, i) => <li><span class="day__h">{p.ora}</span><Icon name={icons[i % icons.length]} size={22} /><span>{p.attivita}</span></li>)}
        </ol>
        {ce.tariffe && <p class="note"><strong>Tariffe:</strong> {ce.tariffe}</p>}
      </div>
      <aside>
        {ce.poster && <img class="ce-poster" src={ce.poster} alt="Volantino del centro estivo FSP" loading="lazy" />}
        <div class="info-box" style="margin-top:20px">
          <h3>Info e iscrizioni</h3>
          <ul class="info-list">
            <li><Icon name="phone" /><span>Segreteria FSP <a href={tel(SITE.phone)}>0549 885691</a><br />Cell. <a href={tel(SITE.mobile)}>335 5704089</a></span></li>
            <li><Icon name="mail" /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><Icon name="facebook" /><a href={SITE.social.facebook} rel="noopener" target="_blank">Federazione Sammarinese Pallacanestro</a></li>
            {ce.responsabile?.nome && <li><Icon name="users" /><span>{ce.responsabile.nome} (Responsabile): <a href={tel(ce.responsabile.telefono)}>{ce.responsabile.telefono}</a></span></li>}
          </ul>
        </div>
      </aside>
    </div>
  </section>
  <section class="section section--soft">
    <div class="wrap">
      <div class="photos"><img src="/media/estivo_1.webp" alt="" loading="lazy" width="640" height="260" /><img src="/media/estivo_2.webp" alt="" loading="lazy" width="640" height="260" /></div>
      {news.length > 0 && <><h2 style="margin-top:40px">Notizie sul centro estivo</h2><NewsGrid items={news} /></>}
    </div>
  </section>
</Base>
<style>
  .ce { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: start; }
  .ce-facts { list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 12px; }
  .ce-facts li { display: flex; gap: 14px; align-items: flex-start; background: var(--c-cyan-soft); padding: 16px 18px; border-radius: var(--radius-sm); }
  .ce-facts :global(svg) { color: var(--c-blue-dark); flex: none; }
  .ce-facts strong { display: block; color: var(--c-navy); }
  .day { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; border-left: 3px solid var(--c-orange); }
  .day li { display: grid; grid-template-columns: 120px 28px 1fr; gap: 10px; align-items: center; padding: 10px 0 10px 16px; position: relative; }
  .day li::before { content: ''; position: absolute; left: -8px; top: 50%; width: 13px; height: 13px; border-radius: 50%; background: #fff; border: 3px solid var(--c-orange); transform: translateY(-50%); }
  .day__h { font-weight: 800; color: var(--c-navy); }
  .day :global(svg) { color: var(--c-orange-dark); }
  .note { margin-top: 24px; }
  .ce-poster { border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; }
  .photos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .photos img { width: 100%; border-radius: var(--radius); }
  @media (max-width: 860px) { .ce, .photos { grid-template-columns: 1fr; } .day li { grid-template-columns: 96px 24px 1fr; } }
</style>
