---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { ATTIVITA_FEDERAZIONE, DIRETTIVO } from '../../data/site';
const links = [
  { href: '/federazione/storia/', icon: 'star', t: 'La nostra storia', d: 'Dal 1968 a oggi: persone, passioni e vittorie.' },
  { href: '/federazione/direttivo/', icon: 'users', t: 'Consiglio direttivo', d: 'Chi guida la Federazione nel quadriennio 2025-2028.' },
  { href: '/federazione/staff-tecnico/', icon: 'ball', t: 'Staff tecnico', d: 'Allenatori, istruttori minibasket e preparatori.' },
  { href: '/federazione/impianti/', icon: 'court', t: 'Impianti', d: 'Le palestre dove giochiamo e ci alleniamo.' },
];
---
<Base title="Chi siamo" description="La Federazione Sammarinese Pallacanestro: consiglio direttivo e attività.">
  <PageHero title="Chi siamo" intro="La Federazione Sammarinese Pallacanestro promuove e organizza il basket nella Repubblica di San Marino, dal Minibasket alla Nazionale." crumbs={[{ label: 'Federazione' }]} />
  <section class="section">
    <div class="wrap fed">
      <div>
        <h2>Le attività della Federazione</h2>
        <ul class="act">
          {ATTIVITA_FEDERAZIONE.map((a) => <li><Icon name="ball" size={22} /><span>{a}</span></li>)}
        </ul>
      </div>
      <aside class="info-box" aria-labelledby="cons-t">
        <h2 id="cons-t" class="h3">Il Consiglio Direttivo</h2>
        <ul class="cons">
          {DIRETTIVO.map((p) => <li><strong>{p.name}</strong> <span>{p.role}</span></li>)}
        </ul>
        <a class="link-arrow" href="/federazione/direttivo/">Conosci il consiglio <Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>
  <section class="section section--soft">
    <div class="wrap">
      <div class="grid grid--4">
        {links.map((l) => (
          <a class="card tile" href={l.href}>
            <span class="tile__i"><Icon name={l.icon} size={28} /></span>
            <span class="tile__t">{l.t}</span>
            <span class="tile__d">{l.d}</span>
          </a>
        ))}
      </div>
      <div class="photos">
        <img src="/media/fed_1.webp" alt="" loading="lazy" width="640" height="259" />
        <img src="/media/fed_2.webp" alt="" loading="lazy" width="640" height="259" />
      </div>
    </div>
  </section>
</Base>
<style>
  .fed { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: start; }
  .act { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .act li { display: flex; gap: 14px; align-items: flex-start; font-size: 1.08rem; }
  .act :global(svg) { color: var(--c-orange); flex: none; margin-top: 3px; }
  .h3 { font-size: 1.3rem; }
  .cons { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 8px; }
  .cons li { display: flex; flex-direction: column; }
  .cons span { color: var(--c-muted); font-size: .95rem; }
  .tile { padding: 24px; text-decoration: none; color: var(--c-text); gap: 8px; transition: transform .2s, box-shadow .2s; }
  .tile:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); color: var(--c-text); }
  .tile__i { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: var(--c-navy); color: #fff; }
  .tile__t { font-weight: 800; font-size: 1.2rem; color: var(--c-navy); }
  .tile__d { color: var(--c-muted); }
  .photos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 32px; }
  .photos img { border-radius: var(--radius); width: 100%; }
  @media (max-width: 860px) { .fed, .photos { grid-template-columns: 1fr; } }
</style>
