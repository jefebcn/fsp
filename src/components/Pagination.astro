---
interface Props { current: number; total: number; base: string }
const { current, total, base } = Astro.props;
const url = (n: number) => (n === 1 ? base : `${base}pagina/${n}/`);
const pages: (number | '…')[] = [];
for (let i = 1; i <= total; i++) {
  if (i === 1 || i === total || Math.abs(i - current) <= 1) pages.push(i);
  else if (pages[pages.length - 1] !== '…') pages.push('…');
}
---
{total > 1 && (
  <nav class="pager" aria-label="Pagine">
    {current > 1 ? <a class="pager__btn" href={url(current - 1)} rel="prev">← Precedenti</a> : <span class="pager__btn" aria-hidden="true" data-disabled>← Precedenti</span>}
    <ul>
      {pages.map((p) => (
        <li>{p === '…' ? <span class="pager__gap">…</span> : <a href={url(p)} aria-current={p === current ? 'page' : undefined} aria-label={`Pagina ${p}`}>{p}</a>}</li>
      ))}
    </ul>
    {current < total ? <a class="pager__btn" href={url(current + 1)} rel="next">Successive →</a> : <span class="pager__btn" aria-hidden="true" data-disabled>Successive →</span>}
  </nav>
)}
<style>
  .pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 48px; }
  .pager ul { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; }
  .pager a, .pager__gap, .pager__btn { display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; padding: 0 12px; border-radius: 999px; font-weight: 700; text-decoration: none; }
  .pager a { border: 2px solid var(--c-border); color: var(--c-navy); background: #fff; }
  .pager a:hover { border-color: var(--c-cyan); }
  .pager a[aria-current='page'] { background: var(--c-navy); border-color: var(--c-navy); color: #fff; }
  .pager__btn[data-disabled] { color: #9aa7b5; }
</style>
