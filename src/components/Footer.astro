---
import Icon from './Icon.astro';
import { NAV, SITE, tel } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="social-band">
    <div class="wrap social-band__in">
      <p class="social-band__t">Segui la FSP: risultati, foto e appuntamenti ogni settimana</p>
      <div class="social-band__links">
        <a class="btn btn--light" href={SITE.social.instagram} rel="noopener" target="_blank"><Icon name="instagram" /> Instagram</a>
        <a class="btn btn--light" href={SITE.social.facebook} rel="noopener" target="_blank"><Icon name="facebook" /> Facebook</a>
      </div>
    </div>
  </div>
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <img src="/media/logo_footer.webp" width="255" height="120" alt="FSP – Federazione Sammarinese Pallacanestro" />
      <p>{SITE.name}<br />{SITE.address.street}, {SITE.address.cap} {SITE.address.city}<br />({SITE.address.country})</p>
      <ul class="footer__contacts">
        <li><Icon name="phone" size={18} /> <a href={tel(SITE.phone)}>{SITE.phone}</a></li>
        <li><Icon name="mail" size={18} /> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
      <div class="footer__fiba">
        <a href={SITE.social.fibaEurope} rel="noopener" target="_blank"><img src="/media/logo_eu.webp" width="57" height="57" alt="FIBA Europe" /></a>
        <a href={SITE.social.fibaEurope} rel="noopener" target="_blank"><img src="/media/logo_fiba.webp" width="55" height="55" alt="FIBA" /></a>
        <a href={SITE.social.facebookGroup} rel="noopener" target="_blank"><img src="/media/logo-fiba.webp" width="120" height="86" alt="FIBA Youth Development Fund" /></a>
      </div>
    </div>
    <nav class="footer__nav" aria-label="Mappa del sito">
      {NAV.filter((n) => n.children).map((n) => (
        <div>
          <h2>{n.label}</h2>
          <ul>{n.children!.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
        </div>
      ))}
      <div>
        <h2>Notizie</h2>
        <ul>
          <li><a href="/news/">Tutte le news</a></li>
          <li><a href="/campionato/">Campionato Sammarinese</a></li>
          <li><a href="/hall-of-fame/">Hall of Fame</a></li>
          <li><a href="/contatti/">Contatti</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="footer__legal">
    <div class="wrap footer__legal-in">
      <span>© {year} {SITE.name} · {SITE.coe} · Fax {SITE.fax}</span>
      <a href="/privacy/">Privacy &amp; Cookie</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--c-navy-deep); color: #c9dcef; margin-top: 0; }
  .site-footer a { color: #fff; }
  .social-band { background: var(--c-cyan); color: #04223f; }
  .social-band__in { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; justify-content: space-between; padding-block: 28px; }
  .social-band__t { margin: 0; font-size: 1.3rem; font-weight: 800; color: #04223f; max-width: 34ch; }
  .social-band__links { display: flex; gap: 12px; flex-wrap: wrap; }
  .social-band .btn--light { color: var(--c-navy); }
  .footer__grid { display: grid; grid-template-columns: minmax(240px, 1fr) 2.4fr; gap: 48px; padding-block: 56px; }
  .footer__brand img { width: 200px; height: auto; margin-bottom: 16px; }
  .footer__brand p { margin-bottom: 12px; }
  .footer__contacts { list-style: none; padding: 0; margin: 0 0 20px; display: grid; gap: 6px; }
  .footer__contacts li { display: flex; gap: 8px; align-items: center; }
  .footer__fiba { display: flex; gap: 10px; align-items: center; }
  .footer__fiba img { height: 48px; width: auto; border-radius: 6px; background: #fff; }
  .footer__nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 28px; }
  .footer__nav h2 { color: #fff; font-size: .95rem; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 12px; }
  .footer__nav ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .footer__nav a { color: #c9dcef; text-decoration: none; }
  .footer__nav a:hover { color: #fff; text-decoration: underline; }
  .footer__legal { border-top: 1px solid rgba(255,255,255,.12); font-size: .9rem; }
  .footer__legal-in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding-block: 18px; }
  @media (max-width: 820px) { .footer__grid { grid-template-columns: 1fr; gap: 36px; } }
</style>
