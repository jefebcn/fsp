---
interface Props { title: string; intro?: string; crumbs?: { label: string; href?: string }[] }
const { title, intro, crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Percorso">
      <ol>
        <li><a href="/">Home</a></li>
        {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>)}
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
    <slot />
  </div>
</section>
