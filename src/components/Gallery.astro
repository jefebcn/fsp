---
// Galleria fotografica con visualizzatore accessibile (dialog nativo, tastiera ←/→/Esc).
interface Props { images: string[]; title?: string }
const { images, title = 'Galleria fotografica' } = Astro.props;
---
{images.length > 0 && (
  <section class="gallery" aria-label={title} data-gallery>
    <h2 class="gallery__t">{title} <span>({images.length} foto)</span></h2>
    <ul class="gallery__grid">
      {images.map((src, i) => (
        <li>
          <a href={src} data-index={i} aria-label={`Apri foto ${i + 1} di ${images.length}`}>
            <img src={src} alt="" loading="lazy" decoding="async" width="400" height="300" />
          </a>
        </li>
      ))}
    </ul>
    <dialog class="lightbox" aria-label="Visualizzatore foto">
      <img alt="" />
      <p class="lightbox__count" aria-live="polite"></p>
      <button type="button" class="lb-btn lb-close" aria-label="Chiudi">✕</button>
      <button type="button" class="lb-btn lb-prev" aria-label="Foto precedente">‹</button>
      <button type="button" class="lb-btn lb-next" aria-label="Foto successiva">›</button>
    </dialog>
  </section>
)}
<style>
  .gallery { margin-top: 40px; }
  .gallery__t { font-size: 1.4rem; }
  .gallery__t span { font-weight: 600; color: var(--c-muted); font-size: 1rem; }
  .gallery__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .gallery__grid a { display: block; border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; }
  .gallery__grid img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .gallery__grid a:hover img { transform: scale(1.05); }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lightbox::backdrop { background: rgba(4, 18, 36, .92); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox img { max-width: min(92vw, 1400px); max-height: 82vh; object-fit: contain; border-radius: 8px; }
  .lightbox__count { position: fixed; bottom: 16px; left: 0; right: 0; text-align: center; color: #fff; font-weight: 700; margin: 0; }
  .lb-btn { position: fixed; width: 56px; height: 56px; border-radius: 50%; border: 0; background: rgba(255,255,255,.95); color: var(--c-navy); font-size: 1.8rem; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .lb-close { top: 16px; right: 16px; font-size: 1.3rem; }
  .lb-prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 16px; top: 50%; transform: translateY(-50%); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const links = Array.from(g.querySelectorAll<HTMLAnchorElement>('.gallery__grid a'));
    const dlg = g.querySelector('dialog')!;
    const img = dlg.querySelector('img')!;
    const count = dlg.querySelector('.lightbox__count')!;
    let idx = 0; let opener: HTMLElement | null = null;
    const show = (i: number) => { idx = (i + links.length) % links.length; img.src = links[idx].href; count.textContent = `Foto ${idx + 1} di ${links.length}`; };
    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); opener = a; show(i); dlg.showModal(); }));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(idx - 1); if (e.key === 'ArrowRight') show(idx + 1); });
    dlg.addEventListener('close', () => opener?.focus());
  });
</script>
